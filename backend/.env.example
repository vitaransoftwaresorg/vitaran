NODE_ENV=production
PORT=8080
# Behind Nginx on the VPS use 127.0.0.1; Cloud Run can leave default 0.0.0.0
HOST=0.0.0.0

# Cloud SQL (Cloud Run unix socket) — preferred in GCP:
# DATABASE_URL=postgresql://vitaran:PASSWORD@localhost/vitaran?host=/cloudsql/PROJECT:REGION:INSTANCE
#
# Or Neon / any Postgres TCP:
DATABASE_URL=postgresql://user:password@host:5432/vitaran?sslmode=verify-full

CORS_ORIGIN=https://YOUR_FRONTEND_URL
APP_URL=https://YOUR_FRONTEND_URL

JWT_SECRET=replace-with-openssl-rand-base64-48
JWT_EXPIRES_IN_HOURS=8
PASSWORD_ENCRYPTION_KEY=replace-with-openssl-rand-base64-48
ADMIN_EMAIL=admin@vitaran.com
ADMIN_PASSWORD=change-me

# Google Cloud Storage — when set, PDFs / OMR / logos leave Postgres
GCS_BUCKET=your-project-vitaran-files
GCS_PROJECT_ID=your-gcp-project-id

# SeaweedFS / S3-compatible (VPS). Preferred over GCS when fully set.
# S3_ENDPOINT=http://127.0.0.1:8333
# S3_BUCKET=vitaranlearning
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE=true
# S3_REGION=us-east-1

# Optional BullMQ (Memorystore Redis / local redis)
# REDIS_URL=redis://127.0.0.1:6379

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Vitaran Learning <noreply@example.com>

GOOGLE_CLIENT_ID=
