generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum SchoolBoard {
  CBSE
  ICSE
  STATE
  IB
  IGCSE
  OTHER
}

enum SchoolType {
  REGULAR
  CUSTOMIZED
}

enum SchoolStatus {
  ACTIVE
  INACTIVE
}

enum Subject {
  MATHEMATICS
  PHYSICS
  CHEMISTRY
  BIOLOGY
  SCIENCE
}

enum TeacherStatus {
  ACTIVE
  INACTIVE
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

/// Mains: one bubble, ADD (any bubble = 4), B/C (either = 4).
/// Advanced: multi-correct with partial marks; full 4 only when every correct option is filled.
enum AnswerKeyPattern {
  MAINS
  ADVANCED
}

/// Admin-managed catalog: name, year, class range and subjects. Fully dynamic.
model LearningProgram {
  id        String    @id @default(uuid()) @db.Uuid
  /// Stable key used on answer keys / results / solution books (e.g. INTEGRATED).
  code      String    @unique @db.VarChar(64)
  name      String    @db.VarChar(120)
  year      Int
  classFrom Int       @map("class_from") @db.SmallInt
  classTo   Int       @map("class_to") @db.SmallInt
  subjects  Subject[]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  schoolPrograms     SchoolProgram[]
  teacherAssignments TeacherAssignment[]
  sections           SchoolSection[]
  classTeachers      ClassTeacher[]
  schoolClasses      SchoolClass[]
  students           Student[]

  @@index([year])
  @@index([createdAt])
  @@map("learning_programs")
}

model School {
  id                String       @id @default(uuid()) @db.Uuid
  serial            Int          @unique @default(autoincrement())
  /// Freeform school ID shown to admins (no format restriction).
  code              String       @unique @db.VarChar(64)
  name              String       @db.VarChar(200)
  board             SchoolBoard
  type              SchoolType   @default(REGULAR)
  status            SchoolStatus @default(ACTIVE)
  principalName     String?      @map("principal_name") @db.VarChar(120)
  contactName       String       @map("contact_name") @db.VarChar(120)
  contactEmail      String       @map("contact_email") @db.VarChar(254)
  contactPhone      String       @map("contact_phone") @db.VarChar(20)
  addressLine       String       @map("address_line") @db.VarChar(300)
  city              String       @db.VarChar(100)
  state             String       @db.VarChar(100)
  pincode           String       @db.VarChar(6)
  studentStrength   Int?         @map("student_strength")
  notes             String?      @db.VarChar(1000)
  accountEmail      String?      @unique @map("account_email") @db.VarChar(254)
  accountPhone      String?      @unique @map("account_phone") @db.VarChar(20)
  passwordHash      String?      @map("password_hash") @db.VarChar(255)
  /// AES-256-GCM so admins can view the password; sign-in always checks the hash.
  passwordEncrypted String?      @map("password_encrypted") @db.VarChar(512)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  answerKeys        AnswerKey[]
  resultSets        ResultSet[]
  teachers          Teacher[]
  schoolPrograms    SchoolProgram[]
  sections          SchoolSection[]
  classTeachers     ClassTeacher[]
  schoolClasses     SchoolClass[]
  students          Student[]
  omScans           OmScan[]
  omResultReleases  OmResultRelease[]

  @@index([status])
  @@index([board])
  @@index([createdAt])
  @@map("schools")
}

/// A school enrolled in a catalog program, with per-class subject selections.
model SchoolProgram {
  id        String              @id @default(uuid()) @db.Uuid
  schoolId  String              @map("school_id") @db.Uuid
  programId String              @map("program_id") @db.Uuid
  school    School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program   LearningProgram     @relation(fields: [programId], references: [id], onDelete: Restrict)
  classes   SchoolProgramClass[]
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([schoolId, programId])
  @@index([programId])
  @@map("school_programs")
}

model SchoolProgramClass {
  id              String        @id @default(uuid()) @db.Uuid
  schoolProgramId String        @map("school_program_id") @db.Uuid
  classLevel      Int           @map("class_level") @db.SmallInt
  subjects        Subject[]
  schoolProgram   SchoolProgram @relation(fields: [schoolProgramId], references: [id], onDelete: Cascade)

  @@unique([schoolProgramId, classLevel])
  @@map("school_program_classes")
}

/// A teacher belongs to one school and only sees content for their class/subject assignments.
model Teacher {
  id                String              @id @default(uuid()) @db.Uuid
  schoolId          String              @map("school_id") @db.Uuid
  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String              @db.VarChar(120)
  email             String              @unique @db.VarChar(254)
  phone             String              @unique @db.VarChar(20)
  status            TeacherStatus       @default(ACTIVE)
  passwordHash      String              @map("password_hash") @db.VarChar(255)
  /// AES-256-GCM so school/admin can view the password; sign-in always checks the hash.
  passwordEncrypted String              @map("password_encrypted") @db.VarChar(512)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  assignments            TeacherAssignment[]
  classTeacherOf         SchoolSection[]
  classTeacherOfClasses  ClassTeacher[]
  omScans                OmScan[]
  omResultReleases       OmResultRelease[]

  @@index([schoolId])
  @@index([status])
  @@index([createdAt])
  @@map("teachers")
}

/// One program + class + subject the teacher is allowed to see.
model TeacherAssignment {
  id         String          @id @default(uuid()) @db.Uuid
  teacherId  String          @map("teacher_id") @db.Uuid
  programId  String          @map("program_id") @db.Uuid
  teacher    Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  program    LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  classLevel Int             @map("class_level") @db.SmallInt
  subject    Subject

  @@unique([teacherId, programId, classLevel, subject])
  @@index([teacherId])
  @@index([programId])
  @@map("teacher_assignments")
}

/// Whole class (no sections): program + seats for an admin-enabled class level.
model SchoolClass {
  id           String          @id @default(uuid()) @db.Uuid
  schoolId     String          @map("school_id") @db.Uuid
  classLevel   Int             @map("class_level") @db.SmallInt
  programId    String          @map("program_id") @db.Uuid
  studentCount Int             @map("student_count") @db.SmallInt
  school       School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program      LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([schoolId, classLevel])
  @@index([programId])
  @@map("school_classes")
}

/// Class-level class teacher when the school has not created sections for that program+class.
model ClassTeacher {
  id         String          @id @default(uuid()) @db.Uuid
  schoolId   String          @map("school_id") @db.Uuid
  programId  String          @map("program_id") @db.Uuid
  classLevel Int             @map("class_level") @db.SmallInt
  teacherId  String          @map("teacher_id") @db.Uuid
  school     School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program    LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  teacher    Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([schoolId, programId, classLevel])
  @@index([teacherId])
  @@map("class_teachers")
}

/// School-defined section (e.g. Class 6-A) with program, strength, and optional class teacher.
model SchoolSection {
  id             String          @id @default(uuid()) @db.Uuid
  schoolId       String          @map("school_id") @db.Uuid
  classLevel     Int             @map("class_level") @db.SmallInt
  name           String          @db.VarChar(32)
  programId      String          @map("program_id") @db.Uuid
  studentCount   Int             @map("student_count") @db.SmallInt
  classTeacherId String?         @map("class_teacher_id") @db.Uuid
  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  program        LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  classTeacher   Teacher?        @relation(fields: [classTeacherId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([schoolId, classLevel, name])
  @@index([schoolId, classLevel])
  @@index([programId])
  @@index([classTeacherId])
  students       Student[]
  @@map("school_sections")
}

/// Student roster: roll no + password login; optional email for password reset.
model Student {
  id                String        @id @default(uuid()) @db.Uuid
  schoolId          String        @map("school_id") @db.Uuid
  school            School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name              String        @db.VarChar(120)
  /// Unique within the school — used with school code to sign in.
  rollNo            String        @map("roll_no") @db.VarChar(64)
  email             String?       @db.VarChar(254)
  programId         String        @map("program_id") @db.Uuid
  program           LearningProgram @relation(fields: [programId], references: [id], onDelete: Restrict)
  classLevel        Int           @map("class_level") @db.SmallInt
  /// Null = whole class (no section).
  sectionId         String?       @map("section_id") @db.Uuid
  section           SchoolSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  status            StudentStatus @default(ACTIVE)
  passwordHash      String        @map("password_hash") @db.VarChar(255)
  passwordEncrypted String        @map("password_encrypted") @db.VarChar(512)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  omScans           OmScan[]

  @@unique([schoolId, rollNo])
  @@index([schoolId, classLevel])
  @@index([programId])
  @@index([sectionId])
  @@index([email])
  @@index([status])
  @@map("students")
}

/// Regular keys are shared by every school on the program; customized keys belong to one school.
/// `programCode` matches LearningProgram.code.
/// `testId` + `testNumber` link keys to results for the same school/program/class.
model AnswerKey {
  id          String     @id @default(uuid()) @db.Uuid
  programCode String     @map("program_code") @db.VarChar(64)
  type        SchoolType
  schoolId    String?    @map("school_id") @db.Uuid
  school      School?    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Human-facing test ID (freeform), shared with results.
  testId      String     @map("test_id") @db.VarChar(64)
  /// Ordinal test number (1–30).
  testNumber  Int        @map("test_number") @db.SmallInt
  classLevel  Int        @map("class_level") @db.SmallInt
  fileName    String     @map("file_name") @db.VarChar(255)
  fileSize    Int        @map("file_size")
  /// PDF bytes; never selected in list queries.
  data        Bytes
  /// Current A–D options, keyed by question number ("1" → "B").
  answers       Json? @map("answers")
  /// Per-question explanation text, keyed by question number.
  explanations  Json? @map("explanations")
  /// KEY table as printed in the PDF. Admin edits never overwrite this.
  printedAnswers Json? @map("printed_answers")
  /// Explanations as first parsed from the PDF (usually empty for scanned keys).
  printedExplanations Json? @map("printed_explanations")
  /// Subject bands in paper order: MPC / PCB (75) or MPCB (100), 25 questions each.
  subjectRanges Json? @map("subject_ranges")
  /// Mains vs Advanced marking. Detected from the PDF; admin can override.
  pattern     AnswerKeyPattern @default(MAINS)
  /// Schools only see published answer keys.
  published   Boolean    @default(false)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  omScans     OmScan[]

  @@unique([testId])
  @@index([createdAt])
  @@index([schoolId])
  @@index([programCode])
  @@index([testId, testNumber])
  @@map("answer_keys")
}

/// One OMR attempt per student per test. Answers stay; scores recompute when the key changes.
model OmScan {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentId     String    @map("student_id") @db.Uuid
  student       Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answerKeyId   String    @map("answer_key_id") @db.Uuid
  answerKey     AnswerKey @relation(fields: [answerKeyId], references: [id], onDelete: Cascade)
  testId        String    @map("test_id") @db.VarChar(64)
  rollNo        String    @map("roll_no") @db.VarChar(64)
  /// Entered by the teacher at scan time (defaults to the scan day).
  examDate      DateTime? @map("exam_date") @db.Date
  answers       Json
  flags         Json
  subjectScores Json      @map("subject_scores")
  correct       Int
  wrong         Int
  blank         Int
  total         Int
  maxTotal      Int       @map("max_total")
  rank          Int?
  classSize     Int?      @map("class_size")
  fileName      String    @map("file_name") @db.VarChar(255)
  fileSize      Int       @map("file_size")
  image         Bytes
  scannedById   String    @map("scanned_by_id") @db.Uuid
  scannedBy     Teacher   @relation(fields: [scannedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([studentId, testId])
  @@index([schoolId, testId])
  @@index([answerKeyId])
  @@index([scannedById])
  @@map("om_scans")
}

/// Class teacher's push of OMR results for one test to one class (section or whole class).
/// Students and subject teachers only see scans whose class is released.
model OmResultRelease {
  id            String    @id @default(uuid()) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  testId        String    @map("test_id") @db.VarChar(64)
  programId     String    @map("program_id") @db.Uuid
  classLevel    Int       @map("class_level") @db.SmallInt
  /// Section id, or "class" for a whole class without sections.
  sectionKey    String    @map("section_key") @db.VarChar(64)
  published     Boolean   @default(false)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  updatedById   String    @map("updated_by_id") @db.Uuid
  updatedBy     Teacher   @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([schoolId, testId, programId, classLevel, sectionKey])
  @@index([updatedById])
  @@map("om_result_releases")
}

/// One test's results for one school and program; each class is uploaded as its own sheet.
model ResultSet {
  id          String        @id @default(uuid()) @db.Uuid
  schoolId    String        @map("school_id") @db.Uuid
  school      School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  /// Regular schools pick a catalog program code.
  programCode String?       @map("program_code") @db.VarChar(64)
  /// Customized schools type their own program name.
  programName String?       @map("program_name") @db.VarChar(120)
  /// `programCode`, or the lowercased custom name; keeps one set per school, program and test.
  programKey  String        @map("program_key") @db.VarChar(130)
  /// Human-facing test ID (freeform).
  testId      String        @map("test_id") @db.VarChar(64)
  /// Ordinal test number (1–30).
  testNumber  Int           @map("test_number") @db.SmallInt
  /// Schools only see published results.
  published   Boolean       @default(false)
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  sheets      ResultSheet[]

  @@unique([schoolId, programKey, testNumber])
  @@index([updatedAt])
  @@index([programCode])
  @@map("result_sets")
}

/// One class's uploaded spreadsheet: its header row, the original file, and one row per student.
model ResultSheet {
  id          String      @id @default(uuid()) @db.Uuid
  resultSetId String      @map("result_set_id") @db.Uuid
  resultSet   ResultSet   @relation(fields: [resultSetId], references: [id], onDelete: Cascade)
  classLevel  Int         @map("class_level") @db.SmallInt
  /// Title lines above the header row, e.g. "TEST-3 9-SEP-2026 (Max. Marks: 300)".
  caption     String[]    @default([])
  /// Header labels, in column order.
  columns     Json
  rowCount    Int         @map("row_count")
  fileName    String      @map("file_name") @db.VarChar(255)
  fileSize    Int         @map("file_size")
  /// Original .xlsx bytes for download; never selected in list queries.
  data        Bytes
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  rows        ResultRow[]

  @@unique([resultSetId, classLevel])
  @@map("result_sheets")
}

model ResultRow {
  sheetId  String      @map("sheet_id") @db.Uuid
  sheet    ResultSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /// 1-based order within the sheet.
  position Int
  /// Cell values aligned with the sheet's `columns`: string, number, boolean or null.
  values   Json

  @@id([sheetId, position])
  @@map("result_rows")
}

enum PasswordResetRole {
  SCHOOL
  TEACHER
  STUDENT
}

/// One-time codes for portal forgot-password (school or teacher).
model PasswordResetOtp {
  id         String            @id @default(uuid()) @db.Uuid
  role       PasswordResetRole
  accountId  String            @map("account_id") @db.Uuid
  email      String            @db.VarChar(254)
  codeHash   String            @map("code_hash") @db.VarChar(128)
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  attempts   Int               @default(0)
  consumedAt DateTime?         @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, role])
  @@index([expiresAt])
  @@map("password_reset_otps")
}
