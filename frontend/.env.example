# Public API origin (baked into the Next.js client at build time for Cloud Run)
NEXT_PUBLIC_API_URL=https://YOUR_API_URL

AUTH_SECRET=replace-with-openssl-rand-base64-48
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://YOUR_FRONTEND_URL

# Local only: copy to frontend/.env (never commit secrets).
# Production VPS (Vitaran): put these in frontend/.env.production ONLY.
# Do NOT create frontend/.env.local on the server — Next loads .env.local over
# .env.production, which previously broke Google login.
